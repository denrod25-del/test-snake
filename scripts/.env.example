# Get a key from https://console.cloud.google.com/
# 1. Create or select a project
# 2. Enable the "Places API (New)"
# 3. Create credentials > API key
# 4. RECOMMENDED: restrict the key to "Places API (New)" only
# 5. RECOMMENDED: set up a daily budget alert to avoid runaway costs
GOOGLE_API_KEY=your_api_key_here

# Firecrawl — https://www.firecrawl.dev/app/api-keys
# Used by enrich-cities.mjs and enrich-reviews.mjs
FIRECRAWL_API_KEY=fc-your_key_here

# Optional: point at self-hosted Firecrawl instead of cloud
# (see firecrawl/SELF_HOST.md and scripts/FIRECRAWL.md)
# FIRECRAWL_API_URL=http://localhost:3002
