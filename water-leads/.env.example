# --- Sales brand baked into outreach templates ---
BRAND_COMPANY_NAME=ClearStream Water
BRAND_CONTACT_NAME=Alex
BRAND_PHONE=(561) 555-0199
BRAND_WEBSITE=https://clearstream.example
BRAND_OFFER_PRICE=299

# --- Target area (defaults to Palm Beach County, FL) ---
TARGET_COUNTY=PALM BEACH
TARGET_STATE=FL

# --- Data file path ---
DATABASE_PATH=water-leads.db

# --- EPA Envirofacts REST endpoint (no key required) ---
EPA_BASE_URL=https://data.epa.gov/efservice

# --- US Census ACS 5-year endpoint (no key required for small volumes,
#     but highly recommended; get one free at https://api.census.gov/data/key_signup.html) ---
CENSUS_ACS_BASE=https://api.census.gov/data/2022/acs/acs5
CENSUS_API_KEY=

# --- Geocoder for ZIP centroids on the map view.
#     Primary source is Zippopotam.us (free, no key). Nominatim is used as a
#     fallback (they gate by User-Agent so set a real contact if you rely on it). ---
ZIPPOPOTAM_URL=https://api.zippopotam.us/us
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
GEOCODE_USER_AGENT=water-leads/1.0 (contact: you@example.com)
GEOCODE_SLEEP=0.2
GEOCODE_COUNTRY=us

# --- Scheduled sync ---
# Set ENABLE_SCHEDULED_SYNC=false to disable the background loop entirely.
# Interval is in hours; 168 = weekly.
ENABLE_SCHEDULED_SYNC=true
SCHEDULE_INTERVAL_HOURS=168

# --- Optional: POST newly-detected alerts to a webhook (Slack/Discord/Zapier) ---
ALERT_WEBHOOK_URL=

# --- Server (daily use) ---
# LISTEN_HOST=127.0.0.1     # use 0.0.0.0 to accept LAN/remote (see README)
# LISTEN_PORT=8000
# AQUA_LEADS_RELOAD=1        # 0 in production; 1 = auto-reload on code changes (dev only)

# --- Optional: password-protect the whole app (browser popup). Use with HTTPS in production. ---
# Skip both to leave the UI open (OK on localhost / Tailscale-only).
# AQUA_LEADS_BASICAUTH_USER=you
# AQUA_LEADS_BASICAUTH_PASS=use-a-long-random-string
