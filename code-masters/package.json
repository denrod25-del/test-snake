{
  "name": "code-masters",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "node ./scripts/clean-next.mjs",
    "dev": "next dev --webpack",
    "dev:3001": "next dev --webpack -p 3001",
    "dev:turbo": "next dev --turbopack",
    "dev:fresh": "npm run clean && next dev --webpack",
    "dev:fresh:3001": "npm run clean && next dev --webpack -p 3001",
    "build": "next build",
    "build:webpack": "next build --webpack",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "next": "16.2.5",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.5",
    "typescript": "^5"
  }
}
