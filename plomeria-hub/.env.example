# Supabase — required for logged-in features (synced notes + bookmarks).
# Without these the app still runs in anonymous (read-only) mode.
# Find them in your Supabase project: Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Public code-reference site used by ViewInCodeLink cross-links.
# Defaults to https://code.bsymbolic.com if unset.
NEXT_PUBLIC_CODE_SITE_URL=https://code.bsymbolic.com
