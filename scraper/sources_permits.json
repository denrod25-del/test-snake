{
  "_comment": "Source configuration for the permits scraper. Each entry maps a jurisdiction name (county or municipality) to a parser + URL. Mirrors sources.json/sources_surplus.json.",
  "_parsers": [
    "pbc_edsweb    -- Palm Beach County eDSWeb (DEFUNCT — portal migrated 2024)",
    "tyler_energov -- Tyler EnerGov SelfService / Civic Access (LIVE for WPB; works for any *.tylerhost.net tenant)",
    "click2gov     -- CentralSquare Click2Gov (Royal Palm Beach; SCAFFOLD)",
    "sagesgov      -- SagesGov (Boynton Beach; SCAFFOLD)",
    "accela        -- Accela Citizen Access (~25 FL counties — TEMPLATE NOT YET IMPLEMENTED)",
    "manual        -- Read entries from manual_permits.json instead of scraping"
  ],
  "_status_legend": [
    "active            -- live scraper exists and runs daily",
    "available         -- public portal exists, scraper not yet built; UI links to portal",
    "scaffold          -- parser stub exists; needs DevTools XHR capture or seed list to finish",
    "manual            -- only manual entries supported",
    "unsupported       -- no public portal available",
    "unsupported_paywall -- public portal exists but is gated by registration / fees"
  ],

  "Palm Beach": {
    "parser":    "pbc_edsweb",
    "url":       "https://pbc.gov/ePZB.Admin.WebSPA/#/",
    "status":    "unsupported_paywall",
    "scope":     "DEFUNCT scraper — county migrated to a registration + reCAPTCHA-gated SPA in 2024",
    "portalUrl": "https://pbc.gov/ePZB.Admin.WebSPA/#/",
    "note":      "Old eDSWeb host (epzb.pbcgov.org) no longer resolves. New portal requires a free account; certified searches are $63 with 7-10 day turnaround. Anonymous bulk scraping is not possible. Use the municipal sources below for unincorporated PBC alternatives."
  },

